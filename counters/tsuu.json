  "cards": [
    {
      "id": "tsuu-letter-1",
      "kind": "plain",
      "text": "三枚の便箋に書いた手紙を封筒に入れ、のりで閉じて、一{}送りました。",
      "en": "I sealed a letter written on three sheets in an envelope and sent it as one complete letter.",
      "noun": "封筒に入れた手紙",
      "phrase": "一通",
      "reading": "いっつう",
      "readingAnswers": [
        "いっつう"
      ],
      "good": [
        "通",
        "一通",
        "本",
        "一本",
        "封",
        "一封"
      ],
      "kana": [
        "いっつう",
        "いっぽん",
        "ほん",
        "いっぷう",
        "ふう"
      ],
      "distractors": [
        "枚",
        "頭",
        "杯"
      ],
      "note": "通 counts the complete letter, not each of its three sheets. 本 can count correspondence, and 封 fits this explicitly sealed-letter unit. 一枚 would count one sheet rather than this complete three-sheet letter. 一通 is いっつう."
    },
    {
      "id": "tsuu-email-1",
      "kind": "plain",
      "text": "まだ読んでいないメールが六{}あります。",
      "en": "There are six email messages that I have not read yet.",
      "noun": "メール",
      "phrase": "六通",
      "reading": "ろくつう",
      "readingAnswers": [
        "ろくつう"
      ],
      "good": [
        "通",
        "六通",
        "件",
        "六件",
        "本",
        "六本",
        "つ",
        "六つ",
        "個",
        "六個"
      ],
      "kana": [
        "ろくつう",
        "ろっけん",
        "けん",
        "ろっぽん",
        "ほん",
        "むっつ",
        "ろっこ",
        "こ"
      ],
      "distractors": [
        "枚",
        "冊",
        "杯"
      ],
      "note": "通 counts messages. 件 also counts inbox entries, 本 can count communications, and conversational つ/個 counts are accepted too. These count messages, not the number of times someone sends them. A digital message is not a physical sheet or bound book. Read the displayed 六通 as ろくつう, not ろっつう."
    },
    {
      "id": "tsuu-application-1",
      "kind": "plain",
      "text": "二枚で一組の申込書に記入し、二枚ともそろえて一{}提出しました。",
      "en": "I filled in and submitted one complete application form consisting of two sheets.",
      "noun": "二枚で一組の申込書",
      "phrase": "一通",
      "reading": "いっつう",
      "readingAnswers": [
        "いっつう"
      ],
      "good": [
        "通",
        "一通",
        "部",
        "一部",
        "組",
        "一組",
        "組み",
        "一組み",
        "セット",
        "一セット",
        "ワンセット",
        "式",
        "一式",
        "件",
        "一件"
      ],
      "kana": [
        "いっつう",
        "いちぶ",
        "ぶ",
        "ひとくみ",
        "くみ",
        "いっせっと",
        "いちせっと",
        "ひとせっと",
        "わんせっと",
        "いっしき",
        "しき",
        "いっけん",
        "けん"
      ],
      "distractors": [
        "枚",
        "頭",
        "杯"
      ],
      "note": "通 counts the complete submitted document, not either individual sheet. 部, 組/組み, セット/ワンセット and 式 can also refer to the complete set here; 件 counts the application as an entry. 一枚 would request only one sheet. Read the displayed 一通 as いっつう."
    }
