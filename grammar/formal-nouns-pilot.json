    {
      "id": "koto-work-hours-fact",
      "jlpt": 3,
      "target": "koto",
      "relationship": "koto-vs-wake",
      "prompt": "勤務時間が来月から午前九時開始に変わるという____を、全員に伝えた。",
      "translation": "Choose こと or わけ and write it in hiragana. Decide whether the sentence reports a fact or event itself, or states a conclusion drawn from known facts. Context: working hours will change to a 9 a.m. start from next month, and this was passed on to everyone.",
      "evidence": "The sentence conveys a piece of information, not the reason for something or a conclusion drawn from premises.",
      "explanation": "こと can package a fact or event as a noun. わけ is used for a reason or an inferred conclusion, neither of which is being asked for here.",
      "answer": "koto",
      "acceptedAnswers": [
        "こと"
      ],
      "options": [
        {
          "id": "koto",
          "label": "こと",
          "rationale": "Packages the reported fact as information."
        },
        {
          "id": "wake",
          "label": "わけ",
          "rationale": "Would point to a reason or a conclusion; no such explanation is being given."
        }
      ],
