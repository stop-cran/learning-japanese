{
  "schemaVersion": 1,
  "id": "formal-nouns-you",
  "title": "よう: comparisons, examples and desired outcomes",
  "article": "articles/koto-wake-and-formal-nouns.md",
  "constructions": [
    {
      "id": "you-adverbial-comparison",
      "label": "ように: describe how an action or property compares"
    },
    {
      "id": "you-noun-modifier",
      "label": "ような: directly describe a noun by comparison or example"
    },
    {
      "id": "you-enabled-goal",
      "label": "ように: act so that someone can do something"
    },
    {
      "id": "you-prevented-goal",
      "label": "ように: act so that someone cannot do something"
    }
  ],
  "relationships": [
    {
      "id": "you-predicate-vs-noun-modification",
      "label": "comparison applied to an action or property / comparison directly modifying a noun",
      "constructions": [
        "you-adverbial-comparison",
        "you-noun-modifier"
      ]
    },
    {
      "id": "you-enable-vs-prevent-ability",
      "label": "making an action possible / making an action unavailable",
      "constructions": [
        "you-enabled-goal",
        "you-prevented-goal"
      ]
    }
  ],
