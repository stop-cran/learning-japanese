          "id": "tokoro-before",
          "label": "書く",
          "rationale": "Matches the blank paper and the explicit 今から."
        },
        {
          "id": "tokoro-during",
          "label": "書いている",
          "rationale": "Would describe the writing as already underway rather than starting now."
        },
        {
          "id": "tokoro-after",
          "label": "書いた",
          "rationale": "Would present a completed letter, conflicting with the still-blank paper."
