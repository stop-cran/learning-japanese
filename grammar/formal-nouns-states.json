{
  "schemaVersion": 1,
  "id": "formal-nouns-states",
  "title": "Formal nouns: a state retained or an action left undone",
  "article": "articles/koto-wake-and-formal-nouns.md",
  "constructions": [
    {
      "id": "mama-result",
      "label": "Vた + まま: the resulting state continues"
    },
    {
      "id": "mama-undone",
      "label": "Vない + まま: the action remains undone"
    }
  ],
  "relationships": [
    {
      "id": "mama-result-vs-undone",
      "label": "retaining an action's result / leaving the action unperformed",
      "constructions": [
        "mama-result",
        "mama-undone"
      ]
    }
  ],
